<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tek izin bu. Ağ izni bile yok: senkron kapalıyken hiçbir istek atılmaz,
         açıkken WebView zaten kendi ağ erişimini kullanır. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/yedekleme_kurallari"
        android:dataExtractionRules="@xml/veri_cikarma_kurallari"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/diller"
        android:theme="@style/KertikTema"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Kertik.Baslangic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bildirim ve Kilit Ekranı Sessiz Eylem Alıcısı (Uygulamayı öne açmadan çalışır) -->
        <receiver
            android:name=".KertikEylemAlici"
            android:exported="false">
            <intent-filter>
                <action android:name="com.yusufgunay.kertik.EYLEM" />
            </intent-filter>
        </receiver>

        <!-- Ana Ekran Widget'ları (Kontrol & Duvar) -->
        <receiver
            android:name=".KontrolWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_kontrol_info" />
        </receiver>

        <receiver
            android:name=".DuvarWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_duvar_info" />
        </receiver>

        <!-- Seans resmini paylaşma ekranına verebilmek için. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosya"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/paylasim_yollari" />
        </provider>
    </application>
</manifest>
